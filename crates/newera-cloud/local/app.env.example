# Optional secrets for the local compose: copy to app.env (git-ignored) to try
# real email or Google sign-in. Without it, sign-in links go to the log.

# Sign-in links by email (https://resend.com; the sender's domain verified there).
# Without it, email sign-in shows "not available yet" and the relay goes on working.
RESEND_API_KEY=
NEWERA_MAIL_FROM=3D New Era AI <entrar@3dneweraai.com>

# "Continue with Google" (an OAuth client of type Web application, redirect URI
# https://mcp.3dneweraai.com/login/google/callback). Optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Defaults, shown for reference.
# NEWERA_PUBLIC_URL=https://mcp.3dneweraai.com
# NEWERA_SITE_ORIGINS=https://3dneweraai.com,https://www.3dneweraai.com

# Only these addresses may sign in (comma separated, any case), each on the owner plan. Unset: anyone.
# NEWERA_ALLOWED_EMAILS=you@example.com

# The paid plan, supported through Buy Me a Coffee (it charges, sends the
# receipt and pays out through the Stripe account connected to it). Both of
# these, or neither (the paid plan off). In Buy Me a Coffee: Memberships for
# the levels, and Integrations -> Webhooks -> Create for a webhook at
# https://mcp.3dneweraai.com/billing/buymeacoffee subscribed to the
# membership.* and recurring_donation.* events; its signing secret is on the
# webhook's own page.
# BUYMEACOFFEE_PAGE=leandrodaf
# BUYMEACOFFEE_WEBHOOK_SECRET=
# The membership levels that pay for the plan, by id, comma separated. Leave
# empty while the page sells nothing but this plan: then every level pays.
# BUYMEACOFFEE_LEVELS=
# Lets a test event from the dashboard change a plan. Never in production:
# there it would give the paid plan away for free.
# BUYMEACOFFEE_TEST_EVENTS=true
